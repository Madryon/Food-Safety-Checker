# AI Vision & Health Models
GEMINI_API_KEY=your_gemini_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here
PORT=5000

# Groq Cloud API (Meta-Llama-3.1-8B-Instruct)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Aiven PostgreSQL Database Connection String
# e.g.: postgres://avnadmin:your_password@your-pg-instance.aivencloud.com:12345/defaultdb?sslmode=require
AIVEN_DATABASE_URL=your_aiven_postgres_url_here
DATABASE_URL=your_aiven_postgres_url_here
