# ==============================================================================
# FoodCheck Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI ENGINES & MULTI-KEY POOLING (Fast Generation & Extended Quota Limits)
# ------------------------------------------------------------------------------

# Google Gemini API Keys (High-precision packaging OCR and FSSAI analysis)
# • Single Key (Standard):
GEMINI_API_KEY=your_gemini_api_key_here

# • Multi-Key Pool (EXTEND REQUEST LIMITS: 1 key = 15 RPM, 3 keys = 45 RPM):
# Add multiple keys comma-separated or as numbered variables. The app automatically
# load-balances across keys and rotates immediately to the next key if one hits 429 quota.
# GEMINI_API_KEYS=key1,key2,key3
# Or:
# GEMINI_API_KEY_1=your_first_gemini_key
# GEMINI_API_KEY_2=your_second_gemini_key
# GEMINI_API_KEY_3=your_third_gemini_key

# Groq Cloud API (ULTRA-FAST GENERATION ~300ms latency, Free 30 RPM & 14,400 RPD)
# Get a free key at https://console.groq.com/keys
# Powers instantaneous health & safety scoring and Meta-Llama diet generation.
GROQ_API_KEY=your_groq_api_key_here
# Optional multiple Groq keys (comma-separated):
# GROQ_API_KEYS=groq_key1,groq_key2
# Model selection:
GROQ_HEALTH_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=llama-3.1-8b-instant

# Optional External Fallback AI Providers (Active if Gemini & Groq are in cooldown)
# • OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# • OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. CAPTCHA PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Choose provider: 'custom' (interactive visual 3x3 image grid, preferred default),
# 'recaptcha' (Google reCAPTCHA v2 Checkbox), or 'turnstile' (Cloudflare Turnstile)
CAPTCHA_PROVIDER=custom

# Cloudflare Turnstile Keys (required only if CAPTCHA_PROVIDER=turnstile)
# Obtain from: https://dash.cloudflare.com/
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Google reCAPTCHA v2 Keys (required only if CAPTCHA_PROVIDER=recaptcha)
# Obtain from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key_here

# ------------------------------------------------------------------------------
# 3. EXTERNAL ENRICHMENT APIS
# ------------------------------------------------------------------------------
# GNews API Key for real-time food safety controversies and recalls
GNEWS_API_KEY=your_gnews_api_key_here

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Defaults to SQLite instance/foodcheck.db if unset.
# For hosted Postgres (e.g. Render / Aiven):
DATABASE_URL=
AIVEN_DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Admin Master Password for administrator login & registration
# Set your secure master password here (can be ADMIN_MASTER_KEY or ADMIN_MASTER_PASSWORD).
ADMIN_MASTER_KEY=your_secure_admin_master_password_here

# Optional Admin 2FA enforcement: set to true to mandate TOTP setup
ADMIN_2FA_ENABLED=false

# Flask Session Secret Key (random string in production)
SECRET_KEY=your_flask_secret_key_here

# Server Port (default 5000 locally, 7860 on Hugging Face / Render dynamic $PORT)
PORT=5000
